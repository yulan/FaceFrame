    "tryOn.failure.denied.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access in Settings to try on glasses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à la caméra dans Réglages pour essayer des lunettes."
          }
        }
      }
    },
